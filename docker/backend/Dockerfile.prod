# Production backend image (daphne ASGI, worker and beat share it). Build context: repository root.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DJANGO_SETTINGS_MODULE=config.settings.production
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr libpq5 curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY backend/requirements/ requirements/
RUN pip install --no-cache-dir -r requirements/prod.txt -c requirements/constraints.txt
COPY backend/ .
# Static files for the Django admin (served by the web container). The key is a throwaway used only for this step.
RUN DJANGO_SETTINGS_MODULE=config.settings.development DJANGO_SECRET_KEY=build-only-not-used-at-runtime-0000000000 \
    DJANGO_ALLOWED_HOSTS=localhost POSTGRES_DB=x POSTGRES_USER=x POSTGRES_PASSWORD=x python manage.py collectstatic --noinput
RUN useradd --system --create-home --uid 10001 app && mkdir -p /app/media /datasets /static-out && chown -R app:app /app/media /datasets /static-out
USER app
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --retries=5 CMD curl -fsS http://localhost:8000/api/v1/health/ || exit 1
CMD ["daphne", "-b", "0.0.0.0", "-p", "8000", "config.asgi:application"]
