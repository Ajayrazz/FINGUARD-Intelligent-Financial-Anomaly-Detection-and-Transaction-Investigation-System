# Copy to .env and change values. NEVER commit .env.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_DB=finguard
POSTGRES_USER=finguard
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Optional: use a Neo4j Aura instance instead of the local container (NEO4J_TARGET=aura)
NEO4J_TARGET=local
NEO4J_AURA_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_AURA_USERNAME=<instance-id>
NEO4J_AURA_PASSWORD=change-me
NEO4J_AURA_DATABASE=<instance-id>
