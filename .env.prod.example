# Copy to .env.prod (git-ignored), fill every value, and keep it OUTSIDE version control. See docs/14.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- site ---
SITE_ADDRESS=finguard.example.com          # public domain (real HTTPS) or "localhost" for a local rehearsal
HTTP_PORT=80
HTTPS_PORT=443
FRONTEND_BASE_URL=https://finguard.example.com   # links in account emails
DJANGO_ALLOWED_HOSTS=finguard.example.com,backend
CORS_ALLOWED_ORIGINS=https://finguard.example.com
CSRF_TRUSTED_ORIGINS=https://finguard.example.com

# --- secrets (the app refuses to start with placeholders or short keys) ---
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
NEO4J_PASSWORD=

# --- fixed wiring ---
DJANGO_SETTINGS_MODULE=config.settings.production
POSTGRES_DB=finguard
POSTGRES_USER=finguard
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0          # internal network only, never published
NEO4J_TARGET=local
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
FINGUARD_DATASETS_DIR=/datasets

# --- email for alert notifications (optional; console backend when empty) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=finguard@example.com
